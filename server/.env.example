# Copy this file to .env and fill it in. .env is never committed (see .gitignore).

# MySQL / MariaDB connection. These defaults match a fresh XAMPP install
# (user "root" with no password). The database is created on first start and
# appears in phpMyAdmin (http://localhost/phpmyadmin) under DB_NAME.
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=dcp_uk

# Admin login. Created automatically on startup if it doesn't exist yet.
# Changing the password later in the admin area is kept (this won't reset it).
ADMIN_EMAIL=you@example.com
ADMIN_PASSWORD=change-me-at-least-10-chars

# Web server
PORT=3000
HOST=127.0.0.1

# Links in emails (login, unsubscribe) start with this address.
APP_BASE_URL=http://localhost:3000
# Signs unsubscribe links. Required in production for bulk email: 32+ random
# characters, e.g. node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
APP_SECRET=

# ---- Email (see DEPLOY.md, "Email") ------------------------------------------
# log    = store in the admin's Sent folder only, nothing is delivered (use locally)
# brevo  = Brevo HTTP API (recommended), needs BREVO_API_KEY
# resend = Resend HTTP API, needs RESEND_API_KEY
# smtp   = any SMTP server (blocked on Railway's non-Pro plans), needs SMTP_*
MAIL_TRANSPORT=log
MAIL_FROM=DCP UK <no-reply@localhost>
# A real chapter inbox that people's replies should reach.
MAIL_REPLY_TO=
BREVO_API_KEY=
RESEND_API_KEY=
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
# Sending pace for the queue, and an optional provider daily cap (Brevo free: 300).
MAIL_RATE_PER_MINUTE=30
MAIL_DAILY_LIMIT=

# Member replies by email: not built yet, keep false.
FEATURE_INBOUND_EMAIL=false

# Production only: apply pending database migrations at startup. Leave unset and
# run "npm run migrate -- --yes" yourself after a backup (DEPLOY.md).
AUTO_MIGRATE=

# Online payments (Stripe, M-Pesa Daraja STK push): designed for but not built.
# Keep false; the webhook routes are stubs and take no money.
FEATURE_STRIPE=false
FEATURE_MPESA_STK=false

# The demo copy of the site (Railway "demo" environment) only: Demo badge, email
# forced to log, seed data allowed, real imports refused. Never true in production.
DEMO_MODE=false

# ---- Operations (DEPLOY.md: "Off-site backups", "Background jobs and file storage")
# S3-compatible storage (Backblaze B2 or Cloudflare R2): nightly off-site backups,
# and uploaded files when STORAGE_DRIVER=s3. Leave empty locally.
S3_ENDPOINT=
S3_BUCKET=
S3_REGION=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
# BACKUP_S3_PREFIX=backups/
# BACKUP_KEEP_DAILY=14
# BACKUP_KEEP_MONTHLY=6
# BACKUP_HOUR_UTC=2

# Where uploaded files go: db (default) | disk (STORAGE_DIR, outside the web root) | s3
STORAGE_DRIVER=db
# STORAGE_DIR=

# loop (default: the app runs its own jobs) | cron (a scheduler runs npm run jobs:run,
# or calls /internal/cron?token=CRON_TOKEN; the token must be 24+ characters)
JOBS_MODE=loop
CRON_TOKEN=

# Put the public site into "back shortly" by hand (e.g. during a restore).
MAINTENANCE_MODE=false
