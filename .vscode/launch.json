{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "DCP UK: site + backend",
      "type": "node",
      "request": "launch",
      "program": "${workspaceFolder}/server/server.js",
      "cwd": "${workspaceFolder}/server",
      "console": "integratedTerminal",
      "serverReadyAction": {
        "pattern": "Admin area:\\s+(https?://\\S+)",
        "uriFormat": "%s",
        "action": "openExternally"
      }
    }
  ]
}
