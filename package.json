{
  "name": "dcp-uk-reform-template",
  "version": "1.0.0",
  "private": true,
  "description": "DCP UK site (Reform-UK-structured reskin) with its backend: member registrations, donation pledges and the admin area.",
  "scripts": {
    "postinstall": "npm --prefix server install",
    "start": "npm --prefix server start",
    "create-admin": "npm --prefix server run create-admin --",
    "admin:reset": "npm --prefix server run admin:reset --",
    "seed:dev": "npm --prefix server run seed:dev --",
    "migrate": "npm --prefix server run migrate --"
  },
  "engines": {
    "node": ">=22.13"
  }
}
